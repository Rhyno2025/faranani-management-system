# ---------------------------------------------------------------------------
# Faranani Property Group — environment file for cPanel
# Copy this file to ".env" in the application root, then fill in the values.
# You can also set these as Environment Variables in the cPanel Node.js
# Selector panel instead of using a file (env panel wins over .env only if
# the key is absent from .env — pick one place and stick to it).
# ---------------------------------------------------------------------------

# Should always be "production" on the live site.
# NOTE: in production the session cookie is marked "Secure", so the site MUST
# be opened over https:// (use cPanel AutoSSL) or logins will not persist.
NODE_ENV=production

# Port the Node process listens on. cPanel/Passenger sets this itself, so leave
# it unset unless your host asks for a specific port.
# PORT=3001

# Optional: keep the SQLite database outside the app folder so it survives
# redeploys of the application code. The folder must exist and be writable.
# FG_DB_PATH=/home/YOUR_CPANEL_USER/faranani-data/faranani.db

# Optional: CALVIN AI assistant (leave blank to keep the assistant switched off)
CALVIN_AI_API_KEY=
CALVIN_AI_BASE_URL=
CALVIN_AI_MODEL=
